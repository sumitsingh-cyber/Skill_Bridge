# ==========================================
# SkillBridge — Environment Variables Guide
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- MongoDB ----
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ---- JWT ----
JWT_SECRET=<generate a long random string, e.g. openssl rand -hex 32>

# ---- Admin Provisioning ----
# Set these to auto-create the first Admin account on first server start.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<strong password>

# ---- Email (choose one or more providers) ----
MAIL_FROM=noreply@yourdomain.com

# Brevo HTTP API (recommended for Render free tier — uses port 443)
BREVO_API_KEY=<your brevo api key>

# Resend (HTTPS, fallback)
RESEND_API_KEY=<your resend api key>
RESEND_FROM=onboarding@resend.dev

# SMTP (may be blocked on Render free tier)
MAIL_HOST=smtp.gmail.com
MAIL_USER=youraddress@gmail.com
MAIL_PASS=<16-character gmail app password>
MAIL_PORT=465

# ---- Cloudinary ----
CLOUD_NAME=<your cloudinary cloud name>
API_KEY=<your cloudinary api key>
API_SECRET=<your cloudinary api secret>
FOLDER_NAME=SkillBridge

# ---- Razorpay ----
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=<your razorpay secret>

# ---- CORS (optional — add additional allowed origins, comma-separated) ----
ALLOWED_ORIGINS=https://your-production-frontend.vercel.app

# ---- Frontend Reset Password Link ----
FRONTEND_URL=https://your-production-frontend.vercel.app

# ---- Runtime ----
NODE_ENV=production
PORT=4000
